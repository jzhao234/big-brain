{
  "name": "@jzhao234/big-brain",
  "version": "0.5.0",
  "description": "A plain-markdown second brain for you and your AI assistants: an Obsidian-compatible vault, MCP server, and CLI for notes, projects, and tasks.",
  "keywords": [
    "second-brain",
    "mcp",
    "model-context-protocol",
    "obsidian",
    "notes",
    "knowledge-base",
    "pkm",
    "llm",
    "claude",
    "tasks",
    "mcp-server",
    "ai-memory",
    "agent-memory",
    "obsidian-vault"
  ],
  "license": "MIT",
  "author": "Junhao Zhao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jzhao234/big-brain.git"
  },
  "homepage": "https://github.com/jzhao234/big-brain#readme",
  "bugs": {
    "url": "https://github.com/jzhao234/big-brain/issues"
  },
  "mcpName": "io.github.jzhao234/big-brain",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "big-brain": "dist/cli/index.js",
    "big-brain-mcp": "dist/mcp/index.js",
    "big-brain-mcp-http": "dist/mcp/http.js"
  },
  "main": "dist/core/index.js",
  "files": [
    "dist",
    "template",
    "skills",
    "prompts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "skills": "npm run build && node scripts/render-skills.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.1.0",
    "express": "^5.2.1",
    "js-yaml": "^5.5.0",
    "minisearch": "^7.1.2",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.9.1",
    "tinyglobby": "^0.2.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
